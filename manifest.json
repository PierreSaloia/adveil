{
    "manifest_version":  3,
    "name":  "AdVeil",
    "version":  "0.3.1",
    "description":  "Bloqueio de anúncios com camuflagem contra detectores, rastreadores opcionais e controle por site. Sem telemetria.",
    "minimum_chrome_version":  "120",
    "permissions":  [
                        "storage",
                        "scripting",
                        "activeTab",
                        "declarativeNetRequest"
                    ],
    "host_permissions":  [
                             "http://*/*",
                             "https://*/*"
                         ],
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "AdVeil",
                   "default_icon":  {
                                        "16":  "assets/icon-16.png",
                                        "32":  "assets/icon-32.png"
                                    }
               },
    "icons":  {
                  "16":  "assets/icon-16.png",
                  "32":  "assets/icon-32.png",
                  "48":  "assets/icon-48.png",
                  "128":  "assets/icon-128.png"
              },
    "options_page":  "options.html",
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "ads",
                                                               "enabled":  true,
                                                               "path":  "rules/ads.json"
                                                           },
                                                           {
                                                               "id":  "regional",
                                                               "enabled":  true,
                                                               "path":  "rules/regional.json"
                                                           },
                                                           {
                                                               "id":  "privacy",
                                                               "enabled":  false,
                                                               "path":  "rules/privacy.json"
                                                           }
                                                       ]
                                },
    "web_accessible_resources":  [
                                     {
                                         "matches":  [
                                                         "http://*/*",
                                                         "https://*/*"
                                                     ],
                                         "resources":  [
                                                           "stubs/*"
                                                       ],
                                         "use_dynamic_url":  true
                                     }
                                 ]
}
